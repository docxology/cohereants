# Published deliverables under output/ ARE tracked (PDF, figures, html, data, tex, slides).
# Only pure build noise / pipeline-internal state inside output/ is ignored:
output/logs/
output/reports/
output/.checkpoints/
output/.pipeline/
output/pdf/_combined_manuscript.*
output/pdf/_xelatex_stdout.log
output/pdf/references.bib

# Disposable working artifacts elsewhere
**/__pycache__/
*.pyc
*.pyo
.coverage
.coverage.*
coverage_project.json
htmlcov/
.pytest_cache/
.benchmarks/
data/*.npz

# Environments / local config
.venv/
.env

# OS / editor cruft
.DS_Store
*.egg-info/
