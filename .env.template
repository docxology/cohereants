# Environment variables for cohereants - Insect Olfaction Research
# Copy this to .env and edit as needed

# Project metadata
AUTHOR_NAME="Tucker Chambers, Daniel A. Friedman"
AUTHOR_ORCID="0000-0001-6232-9096"
AUTHOR_EMAIL="daniel@activeinference.institute"
DOI="10.5281/zenodo.16929408"
PROJECT_TITLE="cohereants"

# Research-specific settings
# Insect species for analysis (comma-separated)
INSECT_SPECIES="Apis mellifera,Bombus terrestris,Drosophila melanogaster"

# Wavelength ranges for infrared analysis (micrometers)
IR_WAVELENGTH_MIN=3.0
IR_WAVELENGTH_MAX=15.0

# Atmospheric transmission parameters
ATMOSPHERIC_MODEL="MODTRAN"
TRANSMISSION_THRESHOLD=0.1

# Data sources
SPECTRA_DATABASE_URL="https://spectra.example.com"
MORPHOLOGY_DATA_PATH="data/insect_morphology.csv"

# Development settings
LOG_LEVEL=1
MPLBACKEND=Agg
